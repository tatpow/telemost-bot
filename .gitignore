# ─────────────────────────────────────────────────────────────
# Секреты и локальная конфигурация
# ─────────────────────────────────────────────────────────────
# Настоящий .env с BOT_TOKEN НЕ должен попадать в git.
.env
.env.*
# ...но шаблон без секретов — оставляем в репозитории:
!.env.example

# ─────────────────────────────────────────────────────────────
# Данные самого бота (сессия, записи, скриншоты)
# ─────────────────────────────────────────────────────────────
# Постоянный профиль Chromium с ЖИВОЙ сессией Яндекса (cookies/логин) — секрет!
browser_profile/
# Записи встреч (могут быть большими и приватными)
recordings/
# Отладочные скриншоты страниц Телемоста
debug_screenshots/
# Логи
*.log
logs/

# ─────────────────────────────────────────────────────────────
# Python (по мотивам github/gitignore -> Python.gitignore)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Пакеты / сборка
build/
dist/
downloads/
eggs/
.eggs/
*.egg
*.egg-info/
.installed.cfg
wheels/
share/python-wheels/
pip-wheel-metadata/
MANIFEST

# Тесты / покрытие / кэши линтеров
.tox/
.nox/
.coverage
.coverage.*
.cache
htmlcov/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# Редакторы / ОС
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
