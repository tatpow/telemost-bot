# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAА-твой-токен-тут

# ID группы одногруппников. Узнать: добавь бота в группу и отправь команду /id.
# 0 = бот реагирует в любом чате (не рекомендуется). Вне этого чата (другие группы, ЛС) — молчит.
GROUP_CHAT_ID=0

# Тема (topic) в супергруппе-форуме, узнать через /id (thread_id).
# 0 = любая тема. Если задан — бот работает только в ней, в остальных просит перейти в тему.
GROUP_THREAD_ID=0

# true — запускать ffmpeg и реально писать видео (нужен Xvfb+PulseAudio, т.е. Docker).
# false — только тестировать логику подключения без записи (например, на Windows без Docker).
# Браузер всегда открывается в видимом (headed) режиме; в Docker он рисуется в Xvfb —
# именно этот дисплей захватывает ffmpeg. Подробнее — в README.
RECORD_ENABLED=true

# true — после успешной отправки видео в Telegram удалять локальную копию из recordings/,
# чтобы не забивать диск. Удаляется ТОЛЬКО если файл прошёл проверку ffprobe и реально ушёл.
DELETE_AFTER_SEND=true

LOG_LEVEL=DEBUG

# Напоминания во время записи (в минутах). 0 = отключить конкретное напоминание.
# Каждые STATUS_REMINDER_MINUTES бот пишет в чат, что всё ещё подключён и пишет запись.
STATUS_REMINDER_MINUTES=10
# Через LECTURE_DURATION_MINUTES (и затем повторно с тем же шагом) бот напоминает,
# что прошла "стандартная" длительность лекции и, возможно, пора отключаться.
LECTURE_DURATION_MINUTES=80
